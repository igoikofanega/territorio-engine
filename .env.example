# Copia a .env y ajusta. NO subas .env al repo.
POSTGRES_USER=territorio
POSTGRES_PASSWORD=territorio
POSTGRES_DB=territorio

# Puertos del HOST (se cambian si chocan con otros proyectos que ya tengas).
# No afectan a la comunicación entre contenedores (esa usa los nombres de servicio).
DB_PORT=5544
API_PORT=8000
DAGSTER_PORT=3010
FRONTEND_PORT=5173
MLFLOW_PORT=5055

# Cadena que usan los servicios Python (async)
DATABASE_URL=postgresql+asyncpg://territorio:territorio@db:5432/territorio

# API key de AEMET (se solicita gratis en opendata.aemet.es). Vacío hasta fase de clima.
AEMET_API_KEY=

# Capa de noticias (fase 3). Cualquier proveedor compatible con la API de OpenAI:
# OpenAI, Groq, DeepSeek, OpenRouter, vLLM, Ollama... Ver docs/adr/0005.
# Sin valores por defecto a propósito: nada debe gastar dinero por descuido.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODELO=
